# ==========================================
# The Last Deploy (TLD) Local Environment Variables Template
# Copy this file to .env.local for local overrides
# ==========================================

# Database Configuration (Docker local setup)
POSTGRES_DB=tld_db
POSTGRES_USER=tld
POSTGRES_PASSWORD=tld_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tld:tld_password@localhost:5432/tld_db

# Backend API Settings
SECRET_KEY=tld-local-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
FRONTEND_URL=http://localhost:9000
BACKEND_PORT=9001

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:9001
FRONTEND_PORT=9000

# Landing & Docs Settings
LANDING_PORT=9002

# External Services (Optional in local dev)
RESEND_API_KEY=
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ANALYTICS_ENABLED=false
POSTHOG_API_KEY=
